# Copy this file to `.env` and fill in real values.
# .env is git-ignored.

# Generate a new one via: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# 1/true/yes = on
DJANGO_DEBUG=true

# Comma-separated hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins with scheme (e.g. https://example.com). Empty for local.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Force HTTPS redirect in production (behind a TLS-terminating proxy)
DJANGO_SECURE_SSL_REDIRECT=false

# HSTS seconds (0 disables). Set to 31536000 in production once ready.
DJANGO_SECURE_HSTS_SECONDS=0
